version: "3.8"

services:

  postgres:
    image: postgres:15
    container_name: postgres
    environment:
      POSTGRES_DB: predictiondb
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data

  ml-service:
    build: ./ml-service
    container_name: ml-service
    ports:
      - "5000:5000"

  prediction-service:
    build: ./prediction-service
    container_name: prediction-service
    depends_on:
      - postgres
      - ml-service
    ports:
      - "8080:8080"

volumes:
  postgres_data: